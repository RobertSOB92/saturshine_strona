---
import '@fontsource/syne/400.css';
import '@fontsource/syne/500.css';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';

import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/dm-sans/400-italic.css';
import '@fontsource/dm-sans/500-italic.css';
import '@fontsource/dm-sans/700-italic.css';

import '../index.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "SaturShine | Profesjonalne Sprzątanie Biur Warszawa — Mycie Okien, Pranie Wykładzin, Polimerowanie Podłóg", 
  description = "SaturShine — profesjonalne sprzątanie biur, mycie przeszkleń, pranie wykładzin i polimerowanie podłóg w Warszawie i okolicach. Bezpłatna wycena po oględzinach. Elastyczne terminy, bezpośredni kontakt z ekipą."
} = Astro.props;
---

<!doctype html>
<html lang="pl" style="scroll-behavior: smooth;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="sprzątanie biur Warszawa, mycie okien Warszawa, pranie wykładzin, polimerowanie podłóg, firma sprzątająca Warszawa, sprzątanie biurowe, mycie przeszkleń" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://saturshine.pl/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://saturshine.pl/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="SaturShine" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />



    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />

    <!-- JSON-LD Structured Data (Main) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CleaningService",
      "name": "SaturShine",
      "url": "https://saturshine.pl/",
      "description": "Profesjonalne sprzątanie biur, mycie przeszkleń, pranie wykładzin i polimerowanie podłóg w Warszawie i okolicach.",
      "areaServed": {
        "@type": "City",
        "name": "Warszawa"
      },
      "email": "kontakt@saturshine.pl",
      "telephone": "+48511727196",
      "knowsAbout": [
        "Sprzątanie biur B2B",
        "Mycie okien i fasad szklanych",
        "Pranie wykładzin biurowych",
        "Polimerowanie podłóg (akrylowanie)",
        "Sprzątanie powierzchni coworkingowych",
        "Dezynfekcja sanitariatów",
        "Doczyszczanie po remoncie"
      ]
    }
    </script>
    <slot name="head" />
  </head>
  <body style="margin: 0; padding: 0;">
    <slot />
  </body>
</html>
